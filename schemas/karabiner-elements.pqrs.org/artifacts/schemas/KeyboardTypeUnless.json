{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "KeyboardTypeUnless.json",
  "title": "Keyboard Type Unless",
  "description": "Defines a condition that checks if the keyboard type does not match a specific value.",
  "type": "object",
  "properties": {
    "type": {
      "const": "keyboard_type_unless"
    },
    "keyboard_types": {
      "type": "array",
      "items": {
        "$ref": "KeyboardType.json"
      },
      "minItems": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the condition."
    }
  },
  "required": [
    "type",
    "keyboard_types"
  ],
  "additionalProperties": false
}