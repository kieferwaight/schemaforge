{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SimultaneousEvent.json",
  "title": "Simultaneous Event",
  "description": "Defines a simultaneous event press",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key_code": {
      "$ref": "FromKeyCodes.json"
    },
    "pointing_button": {
      "$ref": "PointingButton.json"
    },
    "consumer_key_code": {
      "anyOf": [
        {
          "$ref": "FromOnlyConsumerKeyCodes.json"
        },
        {
          "$ref": "GlobalConsumerKeyCodes.json"
        }
      ]
    },
    "any": {
      "$ref": "EventTypes.json"
    }
  }
}