{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ControlOrSymbolKeyCodes.json",
  "title": "Control or Symbol Key Codes",
  "description": "Control or symbol key codes.",
  "type": "string",
  "enum": [
    "return_or_enter",
    "escape",
    "delete_or_backspace",
    "delete_forward",
    "tab",
