{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "VariableIf.json",
  "title": "Variable If",
  "description": "Defines a condition that checks if a variable is set to a specific value.",
  "type": "object",
  "required": [
    "type",
    "name",
    "value"
  ],
  "properties": {
    "type": {
      "const": "variable_if"
    },
    "name": {
      "type": "string"
    },
    "value": {
      "$ref": "VariableValues.json"
    }
  },
  "additionalProperties": false
}