      "$ref": "VariableIf.json"
    },
    {
      "$ref": "VariableUnless.json"
    },
    {
      "$ref": "InputSourceIf.json"
    },
    {
      "$ref": "InputSourceUnless.json"
    },
    {
      "$ref": "FrontmostApplicationIf.json"
    },
    {
      "$ref": "FrontmostApplicationUnless.json"
    },
    {
      "$ref": "KeyboardTypeIf.json"
    },
    {
      "$ref": "KeyboardTypeUnless.json"
    },
    {
      "$ref": "EventChangedIf.json"
    },
    {
      "$ref": "EventChangedUnless.json"
    },
    {
      "$ref": "DeviceExistsIf.json"
    },
    {
      "$ref": "DeviceExistsUnless.json"
    },
    {
      "$ref": "DeviceIf.json"
    },
    {
      "$ref": "DeviceUnless.json"
    },
    {
      "$ref": "DeviceIf.json"
    },
    {
      "$ref": "DeviceUnless.json"
    }
  ]
