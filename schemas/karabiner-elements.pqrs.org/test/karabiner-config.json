{
  "$schema": "../karabiner.json",
  "global": {
    "check_for_updates_on_startup": true,
    "show_in_menu_bar": true,
    "show_profile_name_in_menu_bar": false,
    "show_additional_menu_items": false
  },
  "profiles": [
    {
      "name": "Test Profile",
      "selected": true,
      "simple_modifications": [
        {
          "from": "caps_lock",
          "to": "left_control"
        },
        {
          "from": "right_option",
          "to": "escape"
        }
      ],
      "fn_function_keys": [
        {
          "from": { "key_code": "f1" },
          "to": [{ "consumer_key_code": "display_brightness_decrement" }]
        },
        {
          "from": { "key_code": "f2" },
          "to": [{ "consumer_key_code": "display_brightness_increment" }]
        }
      ],
      "complex_modifications": {
        "parameters": {
          "basic.simultaneous_threshold_milliseconds": 50,
          "basic.to_if_alone_timeout_milliseconds": 1000,
          "basic.to_if_held_down_threshold_milliseconds": 500
        },
        "rules": [
          {
            "description": "Map Caps Lock to Escape on tap, Control on hold",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "left_control"
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "escape"
                  }
                ]
              }
            ]
          },
          {
            "description": "Change spacebar to hyper modifier with conditions",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "spacebar",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "hyper_mode",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "hyper_mode",
                      "value": 0
                    }
                  }
                ],
                "to_if_alone": [
                  {
                    "key_code": "spacebar"
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Terminal$",
                      "^com\\.microsoft\\.VSCode$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Hyper + HJKL for arrow keys",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "left_arrow"
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "hyper_mode",
                    "value": 1
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "down_arrow"
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "hyper_mode",
                    "value": 1
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "up_arrow"
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "hyper_mode",
                    "value": 1
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "right_arrow"
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_if",
                    "name": "hyper_mode",
                    "value": 1
                  }
                ]
              }
            ]
          },
          {
            "description": "Simultaneous key press: J+K to Escape",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "simultaneous": [
                    {
                      "key_code": "j"
                    },
                    {
                      "key_code": "k"
                    }
                  ],
                  "modifiers": {
                    "optional": ["any"]
                  },
                  "simultaneous_options": {
                    "detect_key_down_uninterruptedly": true,
                    "key_down_order": "insensitive",
                    "key_up_order": "insensitive",
                    "key_up_when": "any"
                  }
                },
                "to": [
                  {
                    "key_code": "escape"
                  }
                ]
              }
            ]
          },
          {
            "description": "Test shell command action",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f13"
                },
                "to": [
                  {
                    "shell_command": "open -a 'TextEdit.app'"
                  }
                ]
              }
            ]
          },
          {
            "description": "Mouse key movement",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "w",
                  "modifiers": {
                    "mandatory": ["command", "option"]
                  }
                },
                "to": [
                  {
                    "mouse_key": {
                      "y": -50,
                      "speed_multiplier": 1.5
                    }
                  }
                ],
                "conditions": [
                  {
                    "type": "keyboard_type_if",
                    "keyboard_types": ["ansi", "iso"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Test notification message",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f14"
                },
                "to": [
                  {
                    "set_notification_message": {
                      "id": "test_notification",
                      "text": "Test notification triggered"
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Input source condition test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "semicolon",
                  "modifiers": {
                    "mandatory": ["right_command"]
                  }
                },
                "to": [
                  {
                    "select_input_source": {
                      "language": "^en$"
                    }
                  }
                ],
                "conditions": [
                  {
                    "type": "input_source_unless",
                    "input_sources": [
                      {
                        "language": "^en$"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Delayed action test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": {
                    "mandatory": ["left_control"]
                  }
                },
                "to": [
                  {
                    "key_code": "tab",
                    "modifiers": ["control"]
                  }
                ],
                "to_delayed_action": {
                  "to_if_invoked": [
                    {
                      "set_notification_message": {
                        "id": "delayed_message",
                        "text": "Delayed action triggered"
                      }
                    }
                  ],
                  "to_if_canceled": [
                    {
                      "set_notification_message": {
                        "id": "delayed_message",
                        "text": ""
                      }
                    }
                  ]
                },
                "parameters": {
                  "basic.to_if_alone_timeout_milliseconds": 300
                }
              }
            ]
          },
          {
            "description": "Device condition test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "a",
                  "modifiers": {
                    "mandatory": ["fn"]
                  }
                },
                "to": [
                  {
                    "key_code": "a",
                    "modifiers": ["command"]
                  }
                ],
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "vendor_id": 1452,
                        "product_id": 832,
                        "is_keyboard": true
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Sticky modifiers test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f15"
                },
                "to": [
                  {
                    "sticky_modifiers": {
                      "left_shift": "toggle",
                      "left_control": "on"
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Software function: set mouse cursor position",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f16"
                },
                "to": [
                  {
                    "software_function": {
                      "set_mouse_cursor_position": {
                        "x": "50%",
                        "y": "50%",
                        "screen": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Software function: open application",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f17"
                },
                "to": [
                  {
                    "software_function": {
                      "open_application": {
                        "bundle_identifier": "com.apple.finder"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Pointing button test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "pointing_button": "button4"
                },
                "to": [
                  {
                    "key_code": "left_arrow",
                    "modifiers": ["command"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Consumer key test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "consumer_key_code": "al_terminal_lock_or_screensaver"
                },
                "to": [
                  {
                    "key_code": "power"
                  }
                ]
              }
            ]
          },
          {
            "description": "Apple vendor key codes test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "f18"
                },
                "to": [
                  {
                    "apple_vendor_keyboard_code": "mission_control"
                  }
                ]
              }
            ]
          },
          {
            "description": "Event changed condition test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "return_or_enter",
                  "modifiers": {
                    "mandatory": ["command", "shift"]
                  }
                },
                "to": [
                  {
                    "key_code": "return_or_enter"
                  }
                ],
                "conditions": [
                  {
                    "type": "event_changed_if",
                    "value": true
                  }
                ]
              }
            ]
          },
          {
            "description": "Mouse motion to scroll",
            "manipulators": [
              {
                "type": "mouse_motion_to_scroll",
                "from": {
                  "modifiers": {
                    "mandatory": ["fn"]
                  },
                  "options": {
                    "momentum_scroll_enabled": false,
                    "speed_multiplier": 2.0
                  }
                }
              }
            ]
          }
        ]
      },
      "virtual_hid_keyboard": {
        "country_code": 0,
        "keyboard_type_v2": "ansi",
        "caps_lock_delay_milliseconds": 0
      },
      "devices": [
        {
          "vendor_id": 1452,
          "product_id": 832,
          "is_keyboard": true,
          "is_pointing_device": false
        }
      ]
    },
    {
      "name": "Secondary Profile",
      "selected": false,
      "complex_modifications": {
        "rules": [
          {
            "description": "Variable unless condition test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "b"
                },
                "to": [
                  {
                    "key_code": "b",
                    "modifiers": ["command", "shift"]
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_unless",
                    "name": "special_mode",
                    "value": 1
                  }
                ]
              }
            ]
          },
          {
            "description": "Keypad keys test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "keypad_plus"
                },
                "to": [
                  {
                    "key_code": "equal_sign",
                    "modifiers": ["shift"]
                  }
                ]
              }
            ]
          },
          {
            "description": "Multiple modifiers test",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "delete_or_backspace",
                  "modifiers": {
                    "mandatory": ["command", "shift", "option"]
                  }
                },
                "to": [
                  {
                    "key_code": "delete_forward"
                  }
                ]
              }
            ]
          }
        ]
      },
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "iso"
      }
    }
  ]
}
